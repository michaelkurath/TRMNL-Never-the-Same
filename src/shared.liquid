{% template artwork %}
  <style>
    .never-the-same {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
      padding: 0;
      background: #f1e6cb;
      container-type: size;
    }

    .never-the-same img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .never-the-same .artwork-portrait { display: none; }
    @container (aspect-ratio < 1 / 1) {
      .never-the-same .artwork-landscape { display: none; }
      .never-the-same .artwork-portrait { display: block; }
    }
  </style>
  <div class="layout never-the-same">
    {% if images.landscape != blank and images.portrait != blank %}
      <img class="artwork-landscape" src="{{ images.landscape | escape }}" alt="Never the Same generative artwork">
      <img class="artwork-portrait" src="{{ images.portrait | escape }}" alt="Never the Same generative artwork">
    {% else %}
      <span class="label">Waiting for artwork</span>
    {% endif %}
  </div>
{% endtemplate %}
